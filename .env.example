# ─── Required ──────────────────────────────────────────────
# Your Discord bot token (Bot → Token in the Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Your application/client ID (OAuth2 → General in the Developer Portal)
CLIENT_ID=your_client_id_here

# ─── Optional ──────────────────────────────────────────────
# The guild (server) ID to register slash commands to during development
# Leave blank to register commands globally (takes ~1 hour to propagate)
GUILD_ID=your_guild_id_here

# Banner image shown in the /about embed and on-join welcome message
ABOUT_BANNER_URL=https://your-image-url-here.png

# Fallback image variable (same as ABOUT_BANNER_URL, whichever is set is used)
ABOUT_IMAGE_URL=

# Invite URL for your community/support Discord server (shown in /about buttons)
COMMUNITY_SERVER_URL=https://discord.gg/your-community-server
